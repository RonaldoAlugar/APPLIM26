    <!-- Importação de fonte moderna (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; background: linear-gradient(135deg, #1f2937, #111827); margin: 0; padding: 20px; display: flex; justify-content: center; align-items: center; min-height: 100vh; color: #333; }
        .app-container { width: 100%; max-width: 480px; background: white; padding: 24px; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); text-align: center; position: relative; overflow: hidden; }
        .btn { background-color: #58cc02; color: white; border: none; padding: 14px 20px; font-size: 15px; font-family: 'Poppins', sans-serif; border-radius: 14px; cursor: pointer; width: 100%; margin-top: 15px; font-weight: 600; box-shadow: 0 4px 0 #46a302; transition: transform 0.1s ease; }
        .btn:active { transform: translateY(2px); box-shadow: 0 2px 0 #46a302; }
        .btn:disabled { background-color: #e5e5e5; box-shadow: 0 4px 0 #c5c5c5; cursor: not-allowed; }
        .option { background: #fff; border: 2px solid #e5e5e5; padding: 14px; margin: 10px 0; border-radius: 14px; cursor: pointer; text-align: left; transition: all 0.2s ease; font-size: 14px; font-weight: 500; }
