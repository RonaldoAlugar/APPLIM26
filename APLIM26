</div>

<script>
    let somAtivado = true;

    function alternarSom() {
        somAtivado = !somAtivado;
        let btnSom = document.getElementById('btn-sound');
        if (somAtivado) {
            btnSom.innerHTML = "🔊 Som: ATIVADO";
            btnSom.style.backgroundColor = "#e5e5e5";
            btnSom.style.boxShadow = "0 4px 0 #d1d5db";
        } else {
            btnSom.innerHTML = "🔇 Som: DESATIVADO";
            btnSom.style.backgroundColor = "#fee2e2";
            btnSom.style.boxShadow = "0 4px 0 #fca5a5";
        }
    }

    // Gerador sintético de áudio discreto via Web Audio API (Sons sutis sem arquivos externos)
    function tocarBeep(tipo) {
        if (!somAtivado) return;
        try {
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            
            osc.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            if (tipo === 'acerto') {
                osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // D5
                gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.15);
            } else {
                osc.frequency.setValueAtTime(220, audioCtx.currentTime); // A3
                gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.2);
            }
        } catch (e) {
            // Ignora se o navegador bloquear autoplay sem interação prévia
        }
    }

    // Feedback tátil discreto (Vibração leve)
    function vibrarDispositivo(padrao) {
        if (navigator.vibrate) {
            navigator.vibrate(padrao);
        }
    }

    function validarLicenca() {
        let email = document.getElementById('user-email').value.trim();
        let token = document.getElementById('user-token').value.trim();
        let erroEl = document.getElementById('login-erro');

        if(email === "" || token === "") {
            erroEl.innerText = "Por favor, preencha o e-mail e o token de acesso.";
            return;
        }

        if(token.length < 4) {
            erroEl.innerText = "Token de acesso inválido.";
            return;
        }

        localStorage.setItem('limeira_user_auth', email);
        document.getElementById('screen-login').classList.add('hidden');
        document.getElementById('screen-home').classList.remove('hidden');
    }

    function fazerLogout() {
        localStorage.removeItem('limeira_user_auth');
        document.getElementById('user-email').value = "";
        document.getElementById('user-token').value = "";
        document.getElementById('screen-home').classList.add('hidden');
        document.getElementById('screen-login').classList.remove('hidden');
    }

    function gerarBancoConteudoProgramatico(key, numSimulado) {
        let arr = [];
        let nivelNome = numSimulado === 1 ? "Básico" : (numSimulado === 2 ? "Intermediário" : "Avançado");
        let deslocamento = (numSimulado - 1) * 50;

        let baseDados = {
            portugues: [
                {
                    tema: "Elementos de textualidade: coesão e coerência[cite: 1]",
                    enunciado: "Assinale a alternativa em que o elemento coesivo introduz corretamente uma relação de oposição/adversão conforme os padrões cobrados pela banca Avança SP[cite: 1]:",
                    opcoes: [
                        "A) O candidato estudou bastante, porquanto não obteve a pontuação esperada.",
                        "B) O professor realizou todas as orientações, contudo o resultado não foi imediato.",
                        "C) Visto que o edital foi publicado, logo as inscrições foram encerradas.",
                        "D) Caso o aluno persista no erro, portanto o conceito será revisado.",
                        "E) Conquanto a banca tenha alterado o gabarito, todavia a prova foi anulada."
                    ],
                    correta: 1,
                    comentario: "Comentário (Anexo II - Coesão e Coerência[cite: 1]): 'Contudo' é uma conjunção coordenativa adversativa clássica, exigida em provas estilo Avança SP para indicar contraste entre orações."
                },
                {
                    tema: "Concordância verbal e nominal[cite: 1]",
                    enunciado: "De acordo com a norma-padrão de concordância verbal presente no conteúdo programático de Língua Portuguesa[cite: 1], assinale a alternativa correta:",
                    opcoes: [
                        "A) Devem existir novos critérios para a avaliação no concurso público.",
                        "B) Fazem muitos anos que a rede municipal de Limeira expande suas vagas.",
                        "C) Houveram diversos questionamentos acerca do conteúdo programático.",
                        "D) Sobrou aos candidatos os recursos necessários para a interposição.",
                        "E) Mais de um professor assinaram o termo de posse na Secretaria de Educação."
                    ],
                    correta: 0,
                    comentario: "Comentário (Anexo II - Concordância Verbal[cite: 1]): O verbo 'existir' é transitivo direto e concorda com o sujeito paciente ('novos critérios'). 'Haver' no sentido de existir é invariável (houve), e 'fazer' indicando tempo decorrido também fica no singular."
                },
                {
                    tema: "Regência verbal e nominal[cite: 1]",
                    enunciado: "No que tange à regência verbal exigida pelo edital de Limeira[cite: 1], assinale a alternativa em que o verbo foi empregado corretamente segundo a norma culta:",
                    opcoes: [
                        "A) O docente aspirava o cargo de professor titular na rede municipal.",
                        "B) Visando o melhor desempenho dos alunos, o professor aplicou a atividade.",
                        "C) O candidato obedeceu rigorosamente aos prazos estipulados no edital.",
                        "D) Informamos ao coordenador sobre a alteração do cronograma.",
                        "E) Preferiu assumir o cargo público do que atuar na iniciativa privada."
                    ],
                    correta: 2,
                    comentario: "Comentário (Anexo II - Regência[cite: 1]): O verbo 'obedecer' rege preposição 'a' (objeto indireto). Aspirar (almejar) exige 'a'; visar (no sentido de objetivo) exige 'a'; informar rege objeto direto de pessoa e indireto de coisa (ou vice-versa sem 'sobre'); preferir rege 'a' (e não 'do que')."
                },
                {
                    tema: "Crase e Acentuação gráfica[cite: 1]",
                    enunciado: "Assinale a alternativa em que o uso do acento indicativo de crase preenche corretamente a lacuna, de acordo com as regras gramaticais do edital[cite: 1]:",
                    opcoes: [
                        "A) Os candidatos compareceram ___ sala de prova às 13 horas.",
                        "B) A prefeitura enviou o memorando ___ todos os servidores.",
                        "C) O professor referiu-se ___ uma aluna com dificuldades de aprendizagem.",
                        "D) Os documentos devem ser entregues face ___ diretoria.",
                        "E) Visou ___ melhoria do ensino público municipal."
                    ],
                    correta: 0,
                    comentario: "Comentário (Anexo II - Crase[cite: 1]): 'Comparecer a' + 'a sala' resulta em 'à sala'. Antes de pronome indefinido ('todos') ou artigo indefinido ('uma') não há crase. 'Face a' não possui artigo feminino obrigatório."
                },
                {
                    tema: "Interpretação e compreensão de textos[cite: 1]",
                    enunciado: "Em questões de interpretação e compreensão de textos recorrentes em provas da banca Avança SP[cite: 1], o comando 'infere-se do texto' significa que o candidato deve:",
                    opcoes: [
                        "A) Retirar explicitamente a frase tal qual foi escrita pelo autor.",
                        "B) Buscar informações que estão subentendidas, deduzidas logicamente a partir das premissas do texto.",
                        "C) Inserir opiniões pessoais e vivências empíricas para justificar a resposta.",
                        "D) Considerar falsas todas as afirmativas que contenham adjetivos.",
                        "E) Memorizar o vocabulário semântico sem analisar o contexto discursivo."
                    ],
                    correta: 1,
                    comentario: "Comentário (Anexo II - Interpretação[cite: 1]): 'Inferir' é tirar conclusão lógica daquilo que o texto sugere, diferindo de 'consta no texto' (que exige transcrição literal de dado explícito)."
                }
            ],
            matematica: [
                {
                    tema: "Razão, proporção e Regra de três[cite: 1]",
                    enunciado: "Se 5 professores substitutos corrigem 150 provas em 4 horas de trabalho contínuo, em quanto tempo 10 professores corrigiriam 300 provas mantendo o mesmo ritmo?",
                    opcoes: [
                        "A) 2 horas",
                        "B) 4 horas",
                        "C) 6 horas",
                        "D) 8 horas",
                        "E) 10 horas"
                    ],
                    correta: 1,
                    comentario: "Comentário (Anexo II - Regra de Três Composta[cite: 1]): Montando a proporção: Professores (5 -> 10, inverte por ser grandeza inversamente proporcional) e Provas (150 -> 300, diretamente proporcional). Tem-se: x = 4 * (5/10) * (300/150) = 4 * (1/2) * 2 = 4 horas."
                },
                {
                    tema: "Juros simples e compostos[cite: 1]",
                    enunciado: "Um professor aplicou um capital de R$ 5.000,00 a juros simples a uma taxa mensal de 2%. Qual será o montante total acumulado ao final de 6 meses?",
                    opcoes: [
                        "A) R$ 5.600,00",
                        "B) R$ 5.300,00",
                        "C) R$ 6.000,00",
                        "D) R$ 5.800,00",
                        "E) R$ 6.200,00"
                    ],
                    correta: 0,
                    comentario: "Comentário (Anexo II - Juros Simples[cite: 1]): J = C * i * t => J = 5000 * 0,02 * 6 = R$ 600,00 de juros. O montante é M = C + J = 5000 + 600 = R$ 5.600,00."
                },
                {
                    tema: "Análise combinatória e probabilidade[cite: 1]",
                    enunciado: "Em uma comissão escolar formada por 6 professores e 4 pedagogos, deseja-se formar uma subcomissão com 3 membros, contendo exatamente 2 professores e 1 pedagogo. O número de maneiras distintas para essa escolha é:",
                    opcoes: [
                        "A) 30 maneiras",
                        "B) 60 maneiras",
                        "C) 120 maneiras",
                        "D) 240 maneiras",
                        "E) 50 maneiras"
                    ],
                    correta: 1,
                    comentario: "Comentário (Anexo II - Combinação Simples[cite: 1]): C(6,2) = (6*5)/2 = 15. C(4,1) = 4. Pelo princípio multiplicativo: 15 * 4 = 60 maneiras distintas."
                },
                {
                    tema: "Equações de 1º e 2º grau[cite: 1]",
                    enunciado: "Dada a equação quadrática x² - 7x + 10 = 0, a soma e o produto de suas raízes reais são, respectivamente:",
                    opcoes: [
                        "A) 7 e 10",
                        "B) -7 e 10",
                        "C) 10 e 7",
                        "D) -10 e -7",
                        "E) 5 e 2"
                    ],
                    correta: 0,
                    comentario: "Comentário (Anexo II - Equação do 2º Grau / Relações de Girard[cite: 1]): Pela soma (-b/a) e produto (c/a), para x² - 7x + 10 = 0, a soma é -(-7)/1 = 7 e o produto é 10/1 = 10 (as raízes são 2 e 5)."
                },
                {
                    tema: "Lógica de argumentação e Leis de Morgan[cite: 1]",
                    enunciado: "A negação lógica da proposição composta 'O professor estuda para o concurso E o aluno aprende a matéria' corresponde a:",
                    opcoes: [
                        "A) O professor não estuda para o concurso E o aluno não aprende a matéria.",
