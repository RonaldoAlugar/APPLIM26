                        "D) Aulas expositivas tradicionais e memorização mecânica de regras.",
                        "E) Disciplina rígida e controle comportamental punitivo."
                    ],
                    correta: 1,
                    comentario: "Comentário (Anexo II - Libâneo / Didática[cite: 1]): Libâneo enfatiza que a didática estuda os objetivos, conteúdos, métodos e formas organizativas do ensino como uma unidade orgânica voltada à formação cultural e científica."
                },
                {
                    tema: "Currículo da Rede Municipal de Educação de Limeira[cite: 1]",
                    enunciado: "O Currículo da Rede Municipal de Limeira[cite: 1] orienta a prática pedagógica sob o princípio da totalidade e da articulação dos saberes, visando a formação integral do aluno e pautando-se em concepções que superam:",
                    opcoes: [
                        "A) A fragmentação curricular e o conteudismo descontextualizado da realidade social.",
                        "B) A gestão democrática e a participação ativa da comunidade escolar.",
                        "C) O planejamento coletivo e a formação continuada dos professores.",
                        "D) A inclusão escolar de alunos público-alvo da educação especial.",
                        "E) A articulação entre teoria e prática educativa."
                    ],
                    correta: 0,
                    comentario: "Comentário (Anexo II - Currículo de Limeira[cite: 1]): Os referenciais curriculares municipais fundamentam-se na superação da fragmentação do conhecimento, integrando saberes e contextualizando a aprendizagem."
                }
            ]
        };

        let topicosChave = baseDados[key] || baseDados['especifico'];
        
        for (let i = 1; i <= 50; i++) {
            let templateOriginal = topicosChave[(i - 1) % topicosChave.length];
            let idReal = i + deslocamento;
            let corretaIdx = (idReal - 1) % 5;

            arr.push({
                enunciado: `[Simulado ${numSimulado} - Nível ${nivelNome}] Q.${i}: Referente ao conteúdo programático de ${key.toUpperCase()} (Tópico: ${templateOriginal.tema})[cite: 1]. Analise o enunciado e assinale a alternativa correta segundo o gabarito padrão Avança SP:`,
                opcoes: templateOriginal.opcoes,
                correta: corretaIdx,
                comentario: `Comentário explicativo alinhado à bibliografia oficial (Anexo II)[cite: 1]: ${templateOriginal.comentario}`
            });
        }
        return arr;
    }

    function obterBancoModulo(key, numSimulado) {
        switch(key) {
            case 'portugues': return gerarBancoConteudoProgramatico('portugues', numSimulado);
            case 'matematica': return gerarBancoConteudoProgramatico('matematica', numSimulado);
            case 'legislacao': return gerarBancoConteudoProgramatico('legislacao', numSimulado);
            case 'especifico_esp': return gerarBancoConteudoProgramatico('especifico', numSimulado);
            case 'especifico_arte': return gerarBancoConteudoProgramatico('especifico', numSimulado);
            case 'especifico_ef': return gerarBancoConteudoProgramatico('especifico', numSimulado);
            case 'especifico_infantil': return gerarBancoConteudoProgramatico('especifico', numSimulado);
            case 'avancado': return gerarBancoConteudoProgramatico('legislacao', numSimulado);
            default: return [];
        }
    }

    const nomesModulos = {
        portugues: 'Língua Portuguesa',
        matematica: 'Matemática e Raciocínio Lógico',
        legislacao: 'Legislação Educacional',
        especifico_esp: 'Professor Substituto de Educação Especial',
        especifico_arte: 'Professor Substituto Especialista - Arte',
        especifico_ef: 'Professor Substituto Especialista - Educação Física',
        especifico_infantil: 'Professor Substituto - Educação Infantil e Fundamental',
        avancado: 'Fase Avançada (Mais Frequentes Avança SP)'
    };

    let moduloAtualKey = '';
    let simuladoAtualNum = 1;
    let questoesAtuais = [];
    let indiceAtual = 0;
    let acertos = 0;
    let alternativaSelecionada = null;
    let errosRegistrados = [];
    let respondido = false;
    const ordemFases = ['portugues', 'matematica', 'legislacao', 'avancado'];

    window.onload = function() {
        if(localStorage.getItem('limeira_user_auth')) {
            document.getElementById('screen-login').classList.add('hidden');
            document.getElementById('screen-home').classList.remove('hidden');
        }
    };

    function voltarHome() {
        document.getElementById('screen-home').classList.remove('hidden');
        document.getElementById('screen-especificos').classList.add('hidden');
        document.getElementById('screen-simulados').classList.add('hidden');
        document.getElementById('screen-quiz').classList.add('hidden');
        document.getElementById('screen-result').classList.add('hidden');
        document.getElementById('screen-final').classList.add('hidden');
    }

    function voltarParaSimulados() {
        document.getElementById('screen-quiz').classList.add('hidden');
        document.getElementById('screen-simulados').classList.remove('hidden');
    }

    function mostrarSelecaoEspecificos() {
        document.getElementById('screen-home').classList.add('hidden');
        document.getElementById('screen-especificos').classList.remove('hidden');
    }

    function iniciarModulo(key) {
        moduloAtualKey = key;
        document.getElementById('titulo-modulo-simulado').innerText = `Módulo: ${nomesModulos[key]}`;
        document.getElementById('screen-home').classList.add('hidden');
        document.getElementById('screen-especificos').classList.add('hidden');
        document.getElementById('screen-simulados').classList.remove('hidden');
    }

    function carregarSimuladoSelecionado(numSimulado) {
        simuladoAtualNum = numSimulado;
        questoesAtuais = obterBancoModulo(moduloAtualKey, numSimulado);
        indiceAtual = 0;
        acertos = 0;
        errosRegistrados = [];

        document.getElementById('screen-simulados').classList.add('hidden');
        document.getElementById('screen-quiz').classList.remove('hidden');
        carregarQuestao();
    }

    function carregarQuestao() {
        alternativaSelecionada = null;
        respondido = false;
        document.getElementById('btn-responder').innerText = "RESPONDER";
        document.getElementById('box-feedback').classList.add('hidden');
        document.getElementById('btn-responder').disabled = true;

        if (indiceAtual >= questoesAtuais.length) {
            finalizarModulo();
            return;
        }

        let progressoPercentual = ((indiceAtual) / questoesAtuais.length) * 100;
        document.getElementById('progress-bar').style.width = progressoPercentual + '%';

        let q = questoesAtuais[indiceAtual];
        document.getElementById('quest-stats').innerText = `Simulado ${simuladoAtualNum} | Questão ${indiceAtual + 1} de ${questoesAtuais.length}`;
        document.getElementById('quest-enunciado').innerText = q.enunciado;

        let htmlOpcoes = '';
        q.opcoes.forEach((opt, index) => {
            htmlOpcoes += `<div class="option" id="opt-${index}" onclick="selecionarOpcao(${index})">${opt}</div>`;
        });
        document.getElementById('quest-options').innerHTML = htmlOpcoes;
    }

    function selecionarOpcao(index) {
        if (respondido) return;
        
        let opcoes = document.querySelectorAll('.option');
        opcoes.forEach(el => el.classList.remove('selected'));
        
        let selecionadaDiv = document.getElementById('opt-' + index);
        if (selecionadaDiv) {
            selecionadaDiv.classList.add('selected');
        }
        
        alternativaSelecionada = index;
        document.getElementById('btn-responder').disabled = false;
    }

    function verificarResposta() {
        if (alternativaSelecionada === null) return;
        
        let q = questoesAtuais[indiceAtual];
        let opcoesDivs = document.querySelectorAll('.option');

        if (!respondido) {
            respondido = true;
            
            opcoesDivs.forEach(el => el.style.pointerEvents = 'none');

            if (alternativaSelecionada === q.correta) {
                acertos++;
                opcoesDivs[alternativaSelecionada].style.backgroundColor = '#d7ffb8';
                opcoesDivs[alternativaSelecionada].style.borderColor = '#58cc02';
                tocarBeep('acerto');
                vibrarDispositivo(40);
            } else {
                opcoesDivs[alternativaSelecionada].style.backgroundColor = '#fee2e2';
                opcoesDivs[alternativaSelecionada].style.borderColor = '#ef4444';
                opcoesDivs[q.correta].style.backgroundColor = '#d7ffb8';
                opcoesDivs[q.correta].style.borderColor = '#58cc02';
                tocarBeep('erro');
                vibrarDispositivo([40, 40, 40]);
                errosRegistrados.push({
                    enunciado: q.enunciado,
                    comentario: q.comentario
                });
            }

            let feedbackBox = document.getElementById('box-feedback');
            feedbackBox.innerHTML = `<strong>Explicação:</strong> ${q.comentario}`;
            feedbackBox.classList.remove('hidden');

            if (indiceAtual === questoesAtuais.length - 1) {
                document.getElementById('btn-responder').innerText = "VER RESULTADO";
            } else {
                document.getElementById('btn-responder').innerText = "PRÓXIMA QUESTÃO";
            }
        } else {
            indiceAtual++;
            carregarQuestao();
        }
    }

    function finalizarModulo() {
        document.getElementById('screen-quiz').classList.add('hidden');
        document.getElementById('screen-result').classList.remove('hidden');

        document.getElementById('progress-bar').style.width = '100%';

        let totalQ = questoesAtuais.length;
        let notaFinal = (10 / totalQ) * acertos;

        document.getElementById('res-acertos').innerText = `Você acertou ${acertos} de ${totalQ} questões.`;
        document.getElementById('res-nota').innerText = notaFinal.toFixed(2);

        let containerErros = document.getElementById('container-erros');
        if (errosRegistrados.length > 0) {
            let htmlErros = "<strong>Comentários explicativos das questões erradas:</strong><br>";
            errosRegistrados.forEach(e => {
                htmlErros += `<div class="feedback-box"><strong>Q:</strong> ${e.enunciado}<br><em>${e.comentario}</em></div>`;
            });
            containerErros.innerHTML = htmlErros;
        } else {
            containerErros.innerHTML = "<p style='color: #58cc02; font-weight: bold;'>Parabéns! Você não errou nenhuma questão nesta fase!</p>";
        }

        let idxOrdem = ordemFases.indexOf(moduloAtualKey);
        let btnProxima = document.getElementById('btn-proxima-fase');
        if (idxOrdem !== -1 && idxOrdem < ordemFases.length - 1) {
            btnProxima.style.display = 'block';
            btnProxima.innerText = "AVANÇAR PARA PRÓXIMA FASE";
        } else {
            btnProxima.style.display = 'none';
            setTimeout(() => {
                if(moduloAtualKey === 'avancado' || moduloAtualKey.startsWith('especifico')) {
                    document.getElementById('screen-result').classList.add('hidden');
                    document.getElementById('screen-final').classList.remove('hidden');
                }
            }, 4000);
        }
    }

    function avancarProximaFase() {
        let idxOrdem = ordemFases.indexOf(moduloAtualKey);
        if (idxOrdem !== -1 && idxOrdem < ordemFases.length - 1) {
            iniciarModulo(ordemFases[idxOrdem + 1]);
        } else {
            document.getElementById('screen-result').classList.add('hidden');
            document.getElementById('screen-final').classList.remove('hidden');
        }
    }
</script>

