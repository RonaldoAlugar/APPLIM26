        .input-field { width: 100%; padding: 12px; margin: 8px 0; border: 2px solid #e5e5e5; border-radius: 12px; box-sizing: border-box; font-family: 'Poppins', sans-serif; font-size: 14px; outline: none; transition: border-color 0.2s; }
        .input-field:focus { border-color: #58cc02; }
        
        /* Barra de Progresso Moderna */
        .progress-container { width: 100%; background-color: #e5e5e5; height: 10px; border-radius: 5px; margin-bottom: 20px; overflow: hidden; }
        .progress-bar { width: 0%; height: 100%; background-color: #58cc02; transition: width 0.3s ease; }
        
        /* Botão de Som na Tela Inicial */
        .sound-toggle { background-color: #e5e5e5; color: #374151; box-shadow: 0 4px 0 #d1d5db; margin-top: 10px; }
    </style>
</head>
<body>

<div class="app-container" id="app">
    <!-- TELA 0: Login / Licenciamento Comercial (Proteção Anti-Pirataria) -->
